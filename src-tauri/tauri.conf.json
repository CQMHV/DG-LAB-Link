{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DG-LAB Link",
    "version": "0.1.0",
    "identifier": "cn.dglab.link",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://127.0.0.1:1420",
        "beforeBuildCommand": "npm run build:client",
        "frontendDist": "../dist/client"
    },
    "app": {
        "security": {
            "csp": {
                "default-src": "'self' customprotocol: asset:",
                "connect-src": "ipc: http://ipc.localhost",
                "font-src": "'self'",
                "img-src": "'self' asset: http://asset.localhost blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "object-src": "'none'",
                "base-uri": "'none'",
                "frame-ancestors": "'none'"
            },
            "devCsp": {
                "default-src": "'self' http://127.0.0.1:1420",
                "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420",
                "font-src": "'self'",
                "img-src": "'self' blob: data:",
                "style-src": "'self' 'unsafe-inline'",
                "object-src": "'none'",
                "base-uri": "'none'",
                "frame-ancestors": "'none'"
            }
        },
        "windows": [
            {
                "label": "main",
                "title": "DG-LAB Link",
                "width": 1024,
                "height": 720,
                "minWidth": 760,
                "minHeight": 540,
                "center": true,
                "decorations": false,
                "resizable": true,
                "shadow": true
            }
        ]
    },
    "bundle": {
        "active": false,
        "targets": "all"
    }
}
