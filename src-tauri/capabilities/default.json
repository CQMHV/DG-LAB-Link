{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "DG-LAB Link 主窗口与设备仪表盘窗口基础权限",
    "windows": ["main", "device-*"],
    "permissions": [
        "core:event:allow-listen",
        "core:event:allow-emit-to",
        "core:event:allow-unlisten",
        "core:webview:allow-create-webview-window",
        "core:window:allow-close",
        "core:window:allow-get-all-windows",
        "core:window:allow-minimize",
        "core:window:allow-set-focus",
        "core:window:allow-show",
        "core:window:allow-start-dragging",
        "core:window:allow-toggle-maximize",
        "core:window:allow-unminimize",
        "allow-get-app-preferences",
        "allow-set-close-to-tray",
        "allow-set-auto-start",
        "allow-set-start-minimized",
        "allow-get-hub-snapshot",
        "allow-plugin-call",
        "allow-choose-plugin-package",
        "allow-choose-plugin-file",
        "allow-choose-plugin-destination",
        "allow-get-runtime-info",
        "allow-get-mcp-config",
        "allow-parse-waveform-files",
        "allow-get-custom-waveform",
        "allow-get-connections",
        "allow-connect-transport",
        "allow-disconnect-connection",
        "allow-refresh-connection-pairing",
        "allow-set-relay-endpoint",
        "allow-scan-bluetooth",
        "allow-connect-bluetooth",
        "allow-disconnect-bluetooth",
        "allow-get-bluetooth-config",
        "allow-set-bluetooth-config",
        "allow-adjust-intensity",
        "allow-start-output",
        "allow-stop-output",
        "allow-set-device-channel-source",
        "allow-set-device-channel-source-sync",
        "allow-set-default-source",
        "allow-set-fixed-waveform",
        "allow-import-custom-waveforms",
        "allow-select-custom-waveform",
        "allow-delete-custom-waveform",
        "allow-reorder-custom-waveforms",
        "allow-set-sync-all-devices",
        "allow-update-safety"
    ]
}
